{
  "manifest_version": 3,
  "name": "Manga Reading Companion",
  "version": "0.1.0",
  "description": "Plays music synced to the page you're reading on MangaDex.",
  "author": "Yassine Belhadj",
  "homepage_url": "https://github.com/Qznad/manga-reading-companion",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "manga-reading-companion@qznad",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "src/background/background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mangadex.org/*"
      ],
      "js": [
        "src/content/content.js",
        "src/content/player.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": "icons/icon.svg",
    "default_popup": "src/popup/popup.html",
    "default_title": "Manga Reading Companion"
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://mangadex.org/*",
    "https://api.mangadex.org/*",
    "https://www.youtube.com/*"
  ]
}
